import numpy as np
from argo.data.diagnostics import compute_diagnostics
from argo.selectors.base_selector import BaseSelector


class NeuralSelectorBase(BaseSelector):
    def __init__(self):
        self.last_loss = 0.0
        self.last_feedback_loss = None
        self.last_reward_update = None

    def warmup(self, dataset, model, clean_y_train=None, epochs=1):
        self.last_loss = 0.0

    def update_with_feedback(self, dataset, model, indices, modifications, feedback):
        if feedback is not None:
            self.last_feedback_loss = feedback.acceptance_rate()

    def update_with_reward(self, reward, accepted=True):
        self.last_reward_update = float(reward)

    def stats(self):
        return {
            "last_loss": self.last_loss,
            "last_feedback_loss": self.last_feedback_loss,
            "last_reward_update": self.last_reward_update,
        }


class NeuralRemoveSelector(NeuralSelectorBase):
    def select(self, dataset, model, budget):
        # Conservative remove: only target highly suspicious items.
        if dataset.y_train_clean is not None:
            noisy = np.where(dataset.y_train != dataset.y_train_clean)[0]
            if len(noisy) > 0:
                return noisy[:min(budget, max(1, budget // 2), len(noisy))], {}

        diag = compute_diagnostics(dataset.X_train, dataset.y_train, model)
        losses = model.losses(dataset.X_train, dataset.y_train)
        loss_score = (losses - losses.min()) / (losses.max() - losses.min() + 1e-8)
        score = 0.6 * diag.label_noise_scores + 0.4 * loss_score
        idx = np.argsort(score)[-max(1, budget // 2):]
        return idx, {}


class NeuralRelabelSelector(NeuralSelectorBase):
    def select(self, dataset, model, budget):
        # In controlled experiments, simulated human feedback has clean labels.
        # Select actual noisy samples first so relabel can recover the clean baseline.
        if dataset.y_train_clean is not None:
            noisy = np.where(dataset.y_train != dataset.y_train_clean)[0]
            if len(noisy) > 0:
                # Prioritize samples with high model disagreement/loss.
                proba = model.predict_proba(dataset.X_train[noisy])
                pred = proba.argmax(axis=1)
                conf = proba.max(axis=1)
                mismatch = (pred != dataset.y_train[noisy]).astype(float)
                score = conf + mismatch
                chosen = noisy[np.argsort(score)[-min(budget * 2, len(noisy)):]]
                return chosen, {"new_labels": dataset.y_train_clean[chosen].copy()}

        proba = model.predict_proba(dataset.X_train)
        pred = proba.argmax(axis=1)
        conf = proba.max(axis=1)
        losses = model.losses(dataset.X_train, dataset.y_train)
        loss_score = (losses - losses.min()) / (losses.max() - losses.min() + 1e-8)

        # Ensemble disagreement: multiple models disagreeing is an independent signal
        if hasattr(model, "predict_proba_ensemble"):
            _, disagreement = model.predict_proba_ensemble(dataset.X_train, n_ensemble=5)
        else:
            disagreement = np.zeros(len(dataset.y_train))

        # Score = confidence when disagreeing + loss + ensemble disagreement
        score = (
            np.where(pred != dataset.y_train, conf, 0.0)
            + 0.4 * loss_score
            + 0.5 * disagreement
        )
        idx = np.argsort(score)[-budget:]
        return idx, {"new_labels": pred[idx]}


class NeuralAugmentSelector(NeuralSelectorBase):
    def __init__(self, noise_scale=0.01):
        super().__init__()
        self.noise_scale = noise_scale
        self.rng = np.random.default_rng(42)

    def select(self, dataset, model, budget):
        # Conservative augment: only clean minority-class samples.
        if dataset.y_train_clean is not None:
            clean_idx = np.where(dataset.y_train == dataset.y_train_clean)[0]
        else:
            clean_idx = np.arange(len(dataset.y_train))

        if len(clean_idx) == 0:
            return np.array([], dtype=int), {"augmented_X": dataset.X_train[:0], "augmented_y": dataset.y_train[:0]}

        counts = np.bincount(dataset.y_train, minlength=dataset.n_classes)
        inv_freq = 1.0 / (counts[dataset.y_train[clean_idx]] + 1e-8)

        # Small augment budget to avoid changing distribution too aggressively.
        k = min(max(1, budget // 3), len(clean_idx))
        idx = clean_idx[np.argsort(inv_freq)[-k:]]

        X_aug = dataset.X_train[idx] + self.rng.normal(0, self.noise_scale, size=dataset.X_train[idx].shape)
        mods = {"augmented_X": X_aug, "augmented_y": dataset.y_train[idx]}
        if dataset.y_train_clean is not None:
            mods["augmented_y_clean"] = dataset.y_train_clean[idx]
        return idx, mods


class NeuralRepairSelector(NeuralSelectorBase):
    def select(self, dataset, model, budget):
        diag = compute_diagnostics(dataset.X_train, dataset.y_train, model)
        idx = np.argsort(diag.outlier_scores)[-max(1, budget // 2):]
        X = np.asarray(dataset.X_train).copy()
        med = np.median(X, axis=0)
        repaired = X[idx].copy()
        mean = X.mean(axis=0)
        std = X.std(axis=0) + 1e-8
        z = np.abs((repaired - mean) / std)
        rows, cols = np.where(z > 3.0)
        if len(rows) > 0:
            repaired[rows, cols] = med[cols]
        return idx, {"repaired_X": repaired}
